# AquaGuard Environment Configuration
# Copy this file to .env and fill in your values.

# App
APP_NAME=AquaGuard Edge AI Backend
APP_VERSION=1.0.0
DEBUG=true

# Database – SQLite by default; swap for PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/aquaguard
DATABASE_URL=sqlite:///./aquaguard.db

# CORS – comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Edge AI model version string (informational)
EDGE_MODEL_VERSION=v1.0
